# EAS Build ignore file
# Files and directories to exclude from EAS builds

# Windows system files - exclude all AppData directories
AppData/
**/AppData/**
AppData/Local/
AppData/LocalLow/
AppData/Roaming/
**/AppData/Local/**
**/AppData/LocalLow/**
**/AppData/Roaming/**
**/AppData/Local/Google/**
**/AppData/LocalLow/uTorrent.WebView2/**
**/AppData/LocalLow/**/EBWebView/**
**/Chrome/**
**/uTorrent.WebView2/**
**/*.indexeddb.leveldb/**
**/*.ldb
**/*.log
**/Profile */
**/User Data/**
**/Cache/**
**/Cache_Data/**

# Cursor IDE files
.cursor/
**/.cursor/**

# IDE files
.idea/
*.iml

# Node modules (already excluded but ensure)
node_modules/

# Build artifacts
.expo/
.expo-shared/
dist/
web-build/
*.apk
*.aab
*.ipa

# Environment files
.env
.env.local
.env.*.local
sendgrid.env

# Git files
.git/

# Documentation (optional - remove if you want docs in build)
*.md
!README.md
