# Exclude temp directories that cause EAS build issues
AppData/
AppData/Local/Temp/
**/AppData/Local/Temp/
**/Temp/
*.ps1
ps-script-*

# Exclude build artifacts
.gradle/
android/.gradle/
android/app/build/
android/build/
ios/build/
ios/Pods/
*.apk
*.aab
*.ipa

# Exclude IDE files
.idea/
*.iml

# Exclude EAS temp files
.eas-temp-*/

# Exclude large caches
.gradle/caches/
android/.gradle/caches/
